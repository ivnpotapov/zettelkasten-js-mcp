# Zettelkasten MCP Server Configuration

# Directory for storing note files (relative to project root or absolute path)
ZETTELKASTEN_NOTES_DIR=data/notes

# SQLite database file path (relative to project root or absolute path)
ZETTELKASTEN_DATABASE_PATH=data/db/zettelkasten.db

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
ZETTELKASTEN_LOG_LEVEL=INFO

# Base directory for the project
ZETTELKASTEN_BASE_DIR=.
